rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data.role : null;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'Admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || resource.data.role == 'Admin');
      allow create: if false;
      allow update: if false;
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /cnt/{contactId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                    request.resource.data.keys().hasAll(["user_id", "user_name", "amount", "currency", "category", "urgency", "importance", "reason", "status", "created_at", "updated_at"]) &&
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.status == 'Pending';

      allow update: if isSignedIn() && (
        (
          isAdmin() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'admin_comment', 'decision_date', 'updated_at']) &&
          request.resource.data.status in ['Approved', 'Rejected'] &&
          resource.data.status == 'Pending'
        )
      );
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      
      allow create: if isSignedIn();

      allow update: if isSignedIn() && 
                    resource.data.user_id == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);
    }
    match /relationship/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /wishlist/{wishlistItemId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid && 
                    request.resource.data.keys().hasAll(['userId', 'title', 'category', 'priority', 'status', 'createdAt', 'updatedAt']);
      
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.userId && 
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'description', 'category', 'priority', 'estimatedAmount', 'updatedAt']) && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'createdAt'])
        ) ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /dateIdeas/{dateIdeaId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                    request.resource.data.createdBy == request.auth.uid && 
                    request.resource.data.keys().hasAll(['title', 'category', 'mood', 'createdBy', 'isFavorite', 'status', 'createdAt', 'updatedAt']);
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy || isAdmin()
      );
      
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy || isAdmin()
      );
    }
  }
}
