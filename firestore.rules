rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId) || (isSignedIn() && resource.data.role == 'Admin');
      allow create: if false;
      allow update: if false;
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /cnt/{contactId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);

      allow create: if isSignedIn() &&
                    request.resource.data.keys().hasAll(["user_id", "user_name", "amount", "currency", "category", "urgency", "importance", "reason", "status", "created_at", "updated_at"]) &&
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.status == 'Pending';

      allow update: if isSignedIn() && (
        (
          isAdmin() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'admin_comment', 'decision_date', 'updated_at']) &&
          request.resource.data.status in ['Approved', 'Rejected'] &&
          resource.data.status == 'Pending'
        )
      );
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      
      allow create: if isSignedIn();

      allow update: if isSignedIn() && 
                    resource.data.user_id == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);
    }
    match /relationship/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /wishlist/{wishlistItemId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid && 
                    request.resource.data.keys().hasAll(['userId', 'title', 'category', 'priority', 'status', 'createdAt', 'updatedAt']) &&
                    request.resource.data.status == 'Wanted';
      
      allow update: if isSignedIn() && (
        (
          request.auth.uid == resource.data.userId && 
          resource.data.status == 'Wanted' &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'description', 'category', 'priority', 'updatedAt', 'status', 'claimedAt']) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'createdAt', 'estimatedPointValue', 'adminNote', 'grantedAt']) &&
          (
            request.resource.data.status == 'Wanted' || 
            (request.resource.data.status == 'Claimed' && resource.data.estimatedPointValue != null)
          )
        ) ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'updatedAt', 'estimatedPointValue', 'adminNote', 'grantedAt']))
      );
      
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId && resource.data.status == 'Wanted';
    }

    match /princessPoints/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /pointHistory/{historyId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /quests/{questId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'proofText', 'submittedAt', 'updatedAt']) &&
          request.resource.data.status == 'Submitted' &&
          resource.data.status == 'Active'
        )
      );
      allow delete: if isAdmin();
    }

    match /dateIdeas/{dateIdeaId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                    request.resource.data.createdBy == request.auth.uid && 
                    request.resource.data.keys().hasAll(['title', 'category', 'mood', 'createdBy', 'isFavorite', 'status', 'createdAt', 'updatedAt']);
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy || isAdmin()
      );
      
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy || isAdmin()
      );
    }
  }
}
