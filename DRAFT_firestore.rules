rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'Admin';
    }

    // users setup manually or verified. Wait, if the users collection must exist
    // admin can read all, user can read own
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // we only allow creation by themselves ideally, or maybe no creation if we strictly seed them
      allow create, update, delete: if false; // Users shouldn't be mutable or maybe allow update of name but keep it simple, forbid write.
    }

    match /requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                    request.resource.data.keys().hasAll(["user_id", "user_name", "amount", "currency", "category", "urgency", "importance", "reason", "status", "created_at", "updated_at"]) &&
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.status == 'Pending';

      allow update: if isSignedIn() && (
        (
          isAdmin() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'admin_comment', 'decision_date', 'updated_at']) &&
          request.resource.data.status in ['Approved', 'Rejected'] &&
          resource.data.status == 'Pending'
        )
      );
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      
      allow create: if isSignedIn() && isAdmin(); // Since only admin approving generates it

      allow update: if isSignedIn() && 
                    resource.data.user_id == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);
    }
  }
}
