{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "User"] }
      },
      "required": ["email", "username", "role"]
    },
    "MoneyRequest": {
      "title": "MoneyRequest",
      "description": "A money request submitted by a user",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "category": { "type": "string" },
        "urgency": { "type": "string", "enum": ["Low", "Medium", "High", "Emergency"] },
        "importance": { "type": "string", "enum": ["Low", "Medium", "High", "Very Important"] },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "needed_by_date": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "admin_comment": { "type": "string" },
        "decision_date": { "type": "number" },
        "created_at": { "type": "number" },
        "updated_at": { "type": "number" }
      },
      "required": ["user_id", "user_name", "amount", "currency", "category", "urgency", "importance", "reason", "status", "created_at", "updated_at"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A notification for a user",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "request_id": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "is_read": { "type": "boolean" },
        "created_at": { "type": "number" }
      },
      "required": ["user_id", "message", "is_read", "created_at"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "User wishlist item",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "estimatedPointValue": { "type": "number" },
        "status": { "type": "string", "enum": ["Wanted", "Claimed", "Granted"] },
        "claimedAt": { "type": "number" },
        "grantedAt": { "type": "number" },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "title", "category", "priority", "status", "createdAt", "updatedAt"]
    },
    "PrincessPoints": {
      "title": "PrincessPoints",
      "description": "User's princess points balance",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "balance": { "type": "number" },
        "totalEarned": { "type": "number" },
        "totalSpent": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "balance", "totalEarned", "totalSpent", "updatedAt"]
    },
    "PointHistory": {
      "title": "PointHistory",
      "description": "Log of point transactions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["earned", "spent"] },
        "sourceType": { "type": "string", "enum": ["quest", "wishlist"] },
        "sourceId": { "type": "string" },
        "amount": { "type": "number" },
        "reason": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "type", "sourceType", "sourceId", "amount", "reason", "createdBy", "createdAt"]
    },
    "Quest": {
      "title": "Quest",
      "description": "Mission for earning princess points",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "pointReward": { "type": "number" },
        "difficulty": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Submitted", "Completed", "Rejected", "Expired"] },
        "assignedTo": { "type": "string" },
        "createdBy": { "type": "string" },
        "proofText": { "type": "string" },
        "adminComment": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "submittedAt": { "type": "number" },
        "approvedAt": { "type": "number" }
      },
      "required": ["title", "pointReward", "status", "createdBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user roles and base info"
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/MoneyRequest" },
      "description": "Stores money requests"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Stores user notifications"
    },
    "/wishlist/{wishlistId}": {
      "schema": { "$ref": "#/entities/Wishlist" },
      "description": "User wishlist items"
    },
    "/princessPoints/{userId}": {
      "schema": { "$ref": "#/entities/PrincessPoints" },
      "description": "User princess points balance"
    },
    "/pointHistory/{historyId}": {
      "schema": { "$ref": "#/entities/PointHistory" },
      "description": "Log of point transactions"
    },
    "/quests/{questId}": {
      "schema": { "$ref": "#/entities/Quest" },
      "description": "Missions for earning points"
    }
  }
}
